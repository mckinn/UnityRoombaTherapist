# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# --- BEGIN customization: selective Assets tracking (generated) ---
# Ignore Assets wholesale by default (tutorial art assets are physically
# present on disk for the Unity Editor, but most are not pushed to git).
/[Aa]ssets/*

# ignore any direectories that begin with Claude
/[Cc]laude*/*

# Scripts: fully tracked (all .cs, Configurators/), except the
# scaffolding-for-review subfolder below, which stays ignored.
!/[Aa]ssets/Scripts/
!/[Aa]ssets/Scripts.meta
/[Aa]ssets/Scripts/Roombi additions/old/
/[Aa]ssets/Scripts/Roombi additions/old.meta

# Scenes: only the canonical integration scene is tracked.
!/[Aa]ssets/Scenes/
!/[Aa]ssets/Scenes.meta
/[Aa]ssets/Scenes/*
!/[Aa]ssets/Scenes/TherapyIntegrationSource.unity
!/[Aa]ssets/Scenes/TherapyIntegrationSource.unity.meta

